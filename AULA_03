    {
      "cell_type": "code",
      "source": [
        "import json\n",
        "import re\n",
        "from pathlib import Path\n",
        "\n",
        "pasta_saida = Path(\"/content/aula_2\")\n",
        "arquivos_json = sorted([f for f in pasta_saida.glob(\"*.json\") if \"_metadados\" not in f.name])\n",
        "\n",
        "resultados = []\n",
        "\n",
        "for json_file in arquivos_json:\n",
        "    with open(json_file, \"r\", encoding=\"utf-8\") as f:\n",
        "        dados = json.load(f)\n",
        "\n",
        "    # Junta todos os itens da lista \"texts\" (que é a estrutura comum dos seus JSONs)\n",
        "    itens = dados.get(\"texts\", [])\n",
        "\n",
        "    # ------------------------------------------------------------\n",
        "    # 1) TÍTULO: Primeiro [section_header] com mais de 10 caracteres\n",
        "    # ------------------------------------------------------------\n",
        "    titulo = \"Não identificado\"\n",
        "    for item in itens:\n",
        "        if item.get(\"label\") == \"section_header\":\n",
        "            candidato = item.get(\"text\", \"\").strip()\n",
        "            if len(candidato) > 10:\n",
        "                titulo = candidato\n",
        "                break\n",
        "\n",
        "    # ------------------------------------------------------------\n",
        "    # 2) AUTORES: Linha logo após o título ou que contenha \"1,\"\n",
        "    # ------------------------------------------------------------\n",
        "    autores = []\n",
        "    modo_captura = False\n",
        "    for item in itens:\n",
        "        texto = item.get(\"text\", \"\").strip()\n",
        "        label = item.get(\"label\", \"\")\n",
        "\n",
        "        # Ativa a captura quando encontra o título\n",
        "        if label == \"section_header\" and len(texto) > 10:\n",
        "            modo_captura = True\n",
        "            continue\n",
        "\n",
        "        if modo_captura and label == \"text\":\n",
        "            # Se parece nome de autor (tem número 1, 2... ou asterisco)\n",
        "            if re.search(r\"\\b[A-ZÀ-Ú][a-zà-ú]+.*\\b\\d\\b\", texto) or \"*\" in texto:\n",
        "                # Limpa números e asteriscos\n",
        "                nomes_limpos = re.sub(r\"[*\\d]\", \"\", texto).strip()\n",
        "                # Se tiver vários autores separados por espaço grande ou tab\n",
        "                for nome in re.split(r\"\\s{2,}|(?<=[a-z])\\s+(?=[A-ZÀ-Ú])\", nomes_limpos):\n",
        "                    nome = nome.strip().rstrip(\",\").strip()\n",
        "                    if len(nome.split()) >= 2 and nome not in autores:\n",
        "                        autores.append(nome)\n",
        "                break  # Já pegou a linha de autores\n",
        "            # Se não tem número mas parece nome próprio (2+ palavras com maiúsculas)\n",
        "            elif re.match(r\"^[A-ZÀ-Ú][a-zà-ú]+ [A-ZÀ-Ú][a-zà-ú]+\", texto) and len(texto.split()) >= 2:\n",
        "                # Garante que não é resumo/palavra-chave\n",
        "                if not any(p in texto.lower() for p in [\"resumo\", \"abstract\", \"palavra\", \"keyword\"]):\n",
        "                    autores.append(texto)\n",
        "                    break\n",
        "\n",
        "    # ------------------------------------------------------------\n",
        "    # 3) ANO: Procura \"2025\", \"2026\", etc. nos page_headers ou datas\n",
        "    # ------------------------------------------------------------\n",
        "    ano = \"Não identificado\"\n",
        "    for item in itens:\n",
        "        texto = item.get(\"text\", \"\").strip() + \" \" + item.get(\"label\", \"\")\n",
        "        # Busca ano em contextos de publicação\n",
        "        match = re.search(r\"(?:vol\\.?\\s*\\d+\\s*\\w*\\s*|publicado em |Aceito em |aprovado em )(\\d{4})\", texto, re.IGNORECASE)\n",
        "        if match:\n",
        "            ano = match.group(1)\n",
        "            break\n",
        "    if ano == \"Não identificado\":\n",
        "        # Plano B: qualquer ano entre 2020-2026 nos primeiros textos\n",
        "        for item in itens[:10]:\n",
        "            texto = item.get(\"text\", \"\")\n",
        "            match = re.search(r\"\\b(20[2-9]\\d|2030)\\b\", texto)\n",
        "            if match:\n",
        "                ano = match.group(1)\n",
        "                break\n",
        "\n",
        "    # ------------------------------------------------------------\n",
        "    # 4) Monta e salva o resultado\n",
        "    # ------------------------------------------------------------\n",
        "    resultado = {\n",
        "        \"arquivo_original\": json_file.name.replace(\".json\", \".pdf\"),\n",
        "        \"titulo\": titulo,\n",
        "        \"autores\": autores if autores else [\"Não identificado\"],\n",
        "        \"ano_edicao\": int(ano) if ano.isdigit() else ano\n",
        "    }\n",
        "    resultados.append(resultado)\n",
        "\n",
        "    nome_saida = pasta_saida / f\"{json_file.stem}_metadados.json\"\n",
        "    with open(nome_saida, \"w\", encoding=\"utf-8\") as f:\n",
        "        json.dump(resultado, f, ensure_ascii=False, indent=2)\n",
        "\n",
        "    print(f\"✅ {json_file.name}\")\n",
        "    print(f\"   Título: {titulo}\")\n",
        "    print(f\"   Autores: {autores}\")\n",
        "    print(f\"   Ano: {ano}\\n\")\n",
        "\n",
        "# Salva resumo geral\n",
